    {lat:51.5230, lng:-0.0715, name:"🥯 Beigel Shop — bagel voisin historique, rival de Beigel Bake · ~£5-8/pers"},

    // Jeudi — autour de Tate Modern / Borough / St Paul's
    {lat:51.5049, lng:-0.0925, name:"🍽️ Padella — italien, pâtes fraîches · ~£15-20/pers"},
    {lat:51.5055, lng:-0.0910, name:"🍽️ Arabica Bar and Kitchen — levantin, mezze · ~£20-25/pers"},
