<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>4 jours à Londres — Été</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
<style>
  :root{
    --ink:#1c2430;
    --paper:#f6f3ec;
    --card:#ffffff;
    --navy:#1d3557;
    --red:#c1272d;
    --gold:#b8860b;
    --line:#e3ddcf;
    --muted:#6b6455;
    --lavender:#dedaf0;
    --lavender-ink:#2e2a4a;
    --serif:'Fraunces', Georgia, serif;
    --sans:'Inter', 'Helvetica Neue', Arial, sans-serif;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:var(--sans);
    line-height:1.5;
  }
  .utility{font-family:var(--sans);}
  header.hero{
    background:linear-gradient(160deg, var(--navy) 0%, #0f1e33 100%);
    color:#f2efe4;
    padding:56px 24px 40px;
    position:relative;
    overflow:hidden;
  }
  header.hero::after{
    content:"";
    position:absolute;
    right:-60px; top:-60px;
    width:260px; height:260px;
    border:2px solid rgba(242,239,228,0.12);
    border-radius:50%;
  }
  .lang-switcher{
    position:absolute;
    top:16px; right:20px;
    z-index:5;
    display:flex;
    gap:4px;
    font-family:'Helvetica Neue', Arial, sans-serif;
  }
  .lang-btn{
    background:rgba(242,239,228,0.1);
    border:1px solid rgba(242,239,228,0.25);
    color:#c9d2de;
    font-size:0.72rem;
    font-weight:600;
    letter-spacing:0.04em;
    padding:5px 10px;
    border-radius:20px;
    cursor:pointer;
    transition:all 0.15s ease;
  }
  .lang-btn:hover{
    background:rgba(242,239,228,0.18);
    color:#fff;
  }
  .lang-btn.active{
    background:#f2efe4;
    color:var(--navy);
    border-color:#f2efe4;
  }
  .eyebrow{
    font-family:'Helvetica Neue', Arial, sans-serif;
    text-transform:uppercase;
    letter-spacing:0.18em;
    font-size:0.72rem;
    color:#d7c9a0;
    margin-bottom:14px;
  }
  h1{
    font-family:var(--serif);
    font-size:3.4rem;
    margin:0 0 10px;
    font-weight:500;
    font-style:italic;
    letter-spacing:-0.01em;
    line-height:1.05;
  }
  .sub{
    font-family:var(--sans);
    color:#c9d2de;
    font-size:1rem;
    max-width:640px;
  }
  .stats{
    display:flex;
    gap:28px;
    margin-top:28px;
    flex-wrap:wrap;
    font-family:var(--sans);
  }
  .stat b{display:block; font-size:1.6rem; font-family:var(--serif); font-weight:500; color:#fff;}
  .stat span{font-size:0.72rem; text-transform:uppercase; letter-spacing:0.1em; color:#a9b6c6;}

  nav.days{
    position:sticky; top:0; z-index:20;
    background:var(--paper);
    border-bottom:1px solid var(--line);
    display:flex;
    overflow-x:auto;
    font-family:'Helvetica Neue', Arial, sans-serif;
  }
  nav.days button{
    flex:0 0 auto;
    padding:14px 20px;
    background:none;
    border:none;
    border-bottom:3px solid transparent;
    font-size:0.85rem;
    color:var(--muted);
    cursor:pointer;
    white-space:nowrap;
    letter-spacing:0.02em;
  }
  nav.days button.active{
    color:var(--navy);
    border-bottom-color:var(--red);
    font-weight:600;
  }

  main{max-width:900px; margin:0 auto; padding:32px 20px 80px;}

  .lodging{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:10px;
    padding:20px 22px;
    margin-bottom:36px;
    display:flex;
    gap:18px;
    align-items:flex-start;
  }
  .lodging .icon{font-size:1.8rem;}
  .lodging h3{margin:0 0 4px; font-family:var(--serif); font-size:1.2rem; font-weight:500; color:var(--navy);}
  .lodging p{margin:2px 0; font-family:'Helvetica Neue', Arial, sans-serif; font-size:0.88rem; color:var(--muted);}
  .day-option{
    border:2px solid var(--line);
    border-radius:12px;
    padding:20px;
    margin-bottom:28px;
  }
  .day-option-head{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:16px;
    padding-bottom:12px;
    border-bottom:1px solid var(--line);
  }
  .day-option-head .badge{
    font-family:'Helvetica Neue', Arial, sans-serif;
    font-size:0.7rem;
    font-weight:700;
    letter-spacing:0.06em;
    text-transform:uppercase;
    background:var(--navy);
    color:#fff;
    padding:4px 12px;
    border-radius:20px;
  }
  .day-option-head h3{margin:0; font-family:var(--serif); font-size:1.3rem; font-weight:500;}
  .day-option .timeline{margin-top:0;}
  .tag{
    display:inline-block;
    font-family:'Helvetica Neue', Arial, sans-serif;
    font-size:0.68rem;
    letter-spacing:0.05em;
    text-transform:uppercase;
    background:#fbeee0;
    color:var(--gold);
    padding:2px 8px;
    border-radius:20px;
    margin-top:6px;
  }

  .day-panel{display:none;}
  .day-panel.active{display:block;}

  .day-head{
    margin-bottom:22px;
    padding-bottom:14px;
    border-bottom:2px solid var(--ink);
  }
  .day-head .d{font-family:var(--sans); text-transform:uppercase; letter-spacing:0.18em; font-size:0.72rem; font-weight:700; color:var(--red);}
  .day-head h2{margin:6px 0 0; font-family:var(--serif); font-size:2.3rem; font-weight:500; font-style:italic; letter-spacing:-0.01em; line-height:1.1;}
  .day-head p{font-family:var(--sans); color:var(--muted); font-size:0.88rem; margin:8px 0 0;}

  .timeline{position:relative; padding-left:26px;}
  .timeline::before{
    content:"";
    position:absolute; left:6px; top:6px; bottom:6px;
    width:1px; background:var(--line);
  }
  .stop{
    position:relative;
    margin-bottom:22px;
    background:var(--card);
    border:1px solid var(--line);
    border-radius:10px;
    padding:14px 16px;
  }
  .stop::before{
    content:"";
    position:absolute; left:-26px; top:18px;
    width:11px; height:11px;
    border-radius:50%;
    background:var(--navy);
    border:2px solid var(--paper);
  }
  .stop.restaurant::before{background:var(--red);}
  .stop.walk::before{background:var(--gold);}
  .stop-top{
    display:flex; justify-content:space-between; align-items:baseline; gap:10px; flex-wrap:wrap;
  }
  .stop-top .time{
    font-family:'Helvetica Neue', Arial, sans-serif;
    font-size:0.75rem; color:var(--muted); font-weight:600;
  }
  .stop h4{margin:2px 0 4px; font-family:var(--serif); font-size:1.22rem; font-weight:600; letter-spacing:-0.005em;}
  .stop .cat{
    font-family:'Helvetica Neue', Arial, sans-serif;
    font-size:0.65rem; text-transform:uppercase; letter-spacing:0.06em;
    padding:2px 8px; border-radius:20px; background:#eef2f6; color:var(--navy);
  }
  .stop.restaurant .cat{background:#fbe9e9; color:var(--red);}
  .stop.walk .cat{background:#fbf3e0; color:var(--gold);}
  .stop p.desc{
    font-family:'Helvetica Neue', Arial, sans-serif;
    font-size:0.88rem; color:#3d3a34; margin:4px 0 0;
  }
  .option-list{
    margin-top:8px;
    font-family:'Helvetica Neue', Arial, sans-serif;
    font-size:0.85rem;
  }
  .option-list div{padding:3px 0; color:#3d3a34;}
  .option-list b{color:var(--navy);}

  section.map-section{
    margin-top:56px;
    border-top:1px solid var(--line);
    padding-top:36px;
  }
  section.map-section h2{font-size:1.5rem; font-weight:400; margin-bottom:6px;}
  section.map-section p{font-family:'Helvetica Neue', Arial, sans-serif; color:var(--muted); font-size:0.88rem; margin-top:0;}
  #map{
    height:480px;
    border-radius:12px;
    border:1px solid var(--line);
    margin-top:16px;
  }
  .legend{
    display:flex; gap:18px; flex-wrap:wrap;
    margin-top:14px;
    font-family:'Helvetica Neue', Arial, sans-serif;
    font-size:0.78rem;
    color:var(--muted);
  }
  .legend span{display:flex; align-items:center; gap:6px;}
  .dot{width:10px; height:10px; border-radius:50%; display:inline-block;}

  footer{
    text-align:center;
    font-family:'Helvetica Neue', Arial, sans-serif;
    color:var(--muted);
    font-size:0.8rem;
    padding:30px 20px 50px;
  }

  @media (max-width:600px){
    h1{font-size:1.9rem;}
    .stats{gap:18px;}
  }

  /* --- Impression : version simple, sans mise en page livret --- */
  @media print{
    body{background:#fff;}
    header.hero .lang-switcher, nav.days{ display:none !important; }
    .day-panel{ display:block !important; }
    .stop, .lodging, .day-option{ box-shadow:none !important; break-inside:avoid; }
  }
</style>
</head>

<body>

<header class="hero">
  <div class="lang-switcher">
    <button class="lang-btn active" data-lang="fr">FR</button>
    <button class="lang-btn" data-lang="en">EN</button>
    <button class="lang-btn" data-lang="es">ES</button>
  </div>
  <div class="eyebrow">Guide de voyage personnel</div>
  <h1 class="i18n">4 jours à Londres</h1>
  <div class="sub i18n">Tate Modern · Tate Britain · V&amp;A · British Museum · Camden · West End · les ponts de la Tamise</div>
  <div class="stats">
    <div class="stat"><b>5</b><span>Jours</span></div>
    <div class="stat"><b>5</b><span>Musées</span></div>
    <div class="stat"><b>1</b><span>Tate Boat 🚤</span></div>
    <div class="stat"><b>3</b><span>Ponts</span></div>
    <div class="stat"><b>1</b><span>Soirée West End</span></div>
  </div>
</header>

<nav class="days utility">
  <button class="active i18n" data-day="0">Mercredi 9 Sept · Arrivées</button>
  <button class="i18n" data-day="1">Jeudi 10 Sept · National Gallery/British Museum & West End</button>
  <button class="i18n" data-day="2">Vendredi 11 Sept · Les 2 Tate + Tower Bridge</button>
  <button class="i18n" data-day="3">Samedi 12 Sept · Notting Hill & Camden</button>
  <button class="i18n" data-day="4">Dimanche 13 Sept · V&amp;A & vol retour</button>
</nav>

<main>



  <div class="lodging">
    <div class="icon">🏨</div>
    <div>
      <h3 class="i18n">Logement — Brick Lane, Shoreditch</h3>
      <p>Flat 8, 202–204 Brick Lane, Tower Hamlets, London, E1 6SA, United Kingdom</p>
      <p>Quartier Shoreditch / East London · street art, brunchs, marchés · à 5 min à pied du restaurant Smokestak</p>
      <span class="tag">📍 Sur la carte ci-dessous</span>
    </div>
  </div>

  <div class="lodging" style="border-left:4px solid var(--red); flex-direction:column;">
    <div style="display:flex; gap:14px; align-items:center; margin-bottom:6px;">
      <div class="icon">🍽️</div>
      <h3 style="margin:0;">Restaurants proches de l'hôtel — Shoreditch</h3>
    </div>
    <div class="option-list" style="margin-top:4px;">
      <div><b>SMOKESTAK</b> — 35 Sclater St, E1 6LB · BBQ au feu de bois, viandes fumées · pas de réservation ✅ · 🕒 Ven : 12h-15h puis 17h30-23h</div>
      <div><b>Poppies Fish & Chips</b> — 6-8 Hanbury St, E1 6QR · le fish and chips culte du quartier, déco vintage années 1950, à 3 min à pied du logement 🏛️ · 🕒 Ven : 11h-23h30</div>
      <div><b>Smoking Goat Shoreditch</b> — 63 Charlotte Rd, EC2A 3QS · cuisine thaïe grillée, épicée et conviviale ✅ · 🕒 Ven : cuisine généralement jusqu'à 23h (vérifier sur place, horaires variables selon les sources)</div>
      <div><b>Dishoom Shoreditch</b> — 7 Boundary St, E2 7JE · brasserie irano-indienne façon Bombay, incontournable brunch/dîner ✅ · 🕒 Ven : 8h-minuit</div>
      <div><b>Cecconi's Shoreditch</b> — 10-12 Bethnal Green Rd, E1 6GY (Nobu Hotel Shoreditch) · italien chic, bon pour un dîner plus habillé ✅ · 🕒 Ven : 7h30-23h</div>
      <div><b>Som Saa</b> — 43a Commercial St, E1 6BD · thaï régional dans un ancien entrepôt textile, très bien noté</div>
    </div>
    <span class="tag">🔥 Toutes à moins de 15 min à pied du logement</span>
  </div>

  <!-- JOUR 0 -->
  <div class="day-panel active" id="day-0">
    <div class="day-head">
      <div class="d">Mercredi 9 Septembre</div>
      <h2 class="i18n">Arrivées échelonnées</h2>
      <p class="i18n">Chantal arrive dans l'après-midi · Ricardo et Alexia arrivent en soirée</p>
    </div>
    <div class="timeline">
      <div class="stop">
        <div class="stop-top"><span class="time">14h00</span><span class="cat">Arrivée</span></div>
        <h4 class="i18n">Arrivée de Chantal</h4>
        <p class="desc i18n">Check-in au logement, Flat 8, 202-204 Brick Lane · dépose des bagages.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">15h00</span><span class="cat">Balade</span></div>
        <h4 class="i18n">Old Spitalfields Market & Brick Lane</h4>
        <p class="desc i18n">Après-midi tranquille pour Chantal en attendant les autres · marché couvert historique, boutiques vintage, street art de Brick Lane · à deux pas du logement, idéal pour un premier contact avec le quartier. En chemin : Beigel Bake et Beigel Shop, les deux boutiques de bagels historiques et rivales de Brick Lane, ouvertes tard, parfaites pour un encas. <b>Histoire :</b> Spitalfields Market existe depuis 1638, initialement marché de fruits et légumes ; Brick Lane doit son nom aux briqueteries qui bordaient la rue au XVIe siècle. Le quartier a accueilli des vagues successives d'immigration (huguenots, juifs d'Europe de l'Est, puis bangladais), chacune laissant sa trace — d'où le mélange unique de synagogues devenues mosquées, de curry houses et de street art. <b>Pourquoi y aller :</b> c'est l'histoire vivante de l'immigration londonienne, condensée dans quelques rues.</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">21h50</span><span class="cat">Vol</span></div>
        <h4 class="i18n">Atterrissage de Ricardo et Alexia — Gatwick</h4>
        <p class="desc i18n">Vol BCN → London Gatwick, départ 20h30, arrivée 21h50 · puis Gatwick Express + métro jusqu'à Brick Lane (~1h-1h15).</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">23h00</span><span class="cat">Arrivée</span></div>
        <h4 class="i18n">Arrivée de Ricardo et Alexia à l'hôtel</h4>
        <p class="desc i18n">Check-in au logement · retrouvailles avec Chantal.</p>
      </div>
      <div class="stop restaurant">
        <div class="stop-top"><span class="time">23h30</span><span class="cat">Dîner</span></div>
        <h4 class="i18n">Encas de bienvenue</h4>
        <p class="desc i18n">À cette heure, mieux vaut un encas léger que sortir dîner · Beigel Bake (ouvert 24h/24) ou repas léger à l'appartement · dîner ensemble prévu plutôt le lendemain soir.</p>
      </div>
    </div>
  </div>

  <!-- JOUR 1 -->
  <div class="day-panel" id="day-1">
    <div class="day-head">
      <div class="d">Jeudi 10 Septembre</div>
      <h2 class="i18n">Centre historique & soirée West End</h2>
      <p class="i18n">British Museum, Covent Garden, Trafalgar Square et un spectacle en soirée</p>
    </div>
    <div class="timeline">
      <div class="stop walk">
        <div class="stop-top"><span class="time">09h45</span><span class="cat">Trajet</span></div>
        <h4 class="i18n">Métro vers Holborn</h4>
        <p class="desc i18n">Depuis l'hôtel (Brick Lane) : marcher ~10 min jusqu'à <b>Liverpool Street</b>, puis <b>Central line</b> direction ouest jusqu'à <b>Holborn</b> (4 arrêts : Bank, St Paul's, Chancery Lane, Holborn) · ~10 min de trajet, sans changement · Hunterian Museum et British Museum sont tous deux à moins de 10 min à pied de la sortie du métro.</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">10h00</span><span class="cat">Option A</span></div>
        <h4 class="i18n">Hunterian Museum</h4>
        <p class="desc i18n">38-43 Lincoln's Inn Fields, Holborn · <b>si Option A choisie, à faire en premier</b> (la National Gallery est trop loin du British Museum pour l'enchaîner après, mais tout près de Covent Garden) · collection médicale historique du chirurgien John Hunter (XVIIIe s.) : spécimens anatomiques, squelettes, instruments chirurgicaux d'époque · fascinant pour les curieux d'histoire de la médecine, mais clinique et parfois cru. <b>🕒 Ouvert mar-sam 10h-17h · Gratuit</b> (don de £3 suggéré) · billet horodaté gratuit recommandé en ligne. <b>Histoire :</b> John Hunter (1728-1793), pionnier de la chirurgie moderne et de l'anatomie comparée, a légué sa collection personnelle au Royal College of Surgeons ; le musée a rouvert en 2023 après 6 ans de rénovation. <b>À ne pas rater :</b> les instruments chirurgicaux de Joseph Lister (pionnier de l'antisepsie), les tables anatomiques du XVIIe siècle réalisées pour le diariste John Evelyn, et les spécimens pathologiques qui ont formé des générations de chirurgiens.</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">10h45</span><span class="cat">Option A</span></div>
        <h4 class="i18n">Sir John Soane's Museum</h4>
        <p class="desc i18n">13 Lincoln's Inn Fields · littéralement sur la même place que le Hunterian Museum, à traverser le square · maison de l'architecte néoclassique Sir John Soane, préservée telle qu'il l'a laissée à sa mort en 1837 · intérieur labyrinthique et spectaculaire : miroirs et perspectives truquées démultipliant l'espace, antiquités entassées du sol au plafond, un sarcophage égyptien en albâtre dans la cave. <b>🕒 Ouvert mer-dim 10h-17h (dernière entrée 16h30) · Gratuit</b> — pas de réservation nécessaire, mais file d'attente possible (capacité limitée). <b>Histoire :</b> Soane, architecte de la Banque d'Angleterre, a rassemblé ici 20 000 dessins d'architecture, des antiquités, et des œuvres de Turner, Canaletto et Piranèse ; si heureux de recevoir le sarcophage de Seti Ier qu'il organisa une fête de trois jours pour l'occasion. <b>À ne pas rater :</b> la série complète de "La Carrière d'un libertin" de Hogarth (derrière des panneaux à ouvrir soi-même), le sarcophage de Seti Ier, et la Breakfast Room, chef-d'œuvre de lumière et de miroirs.</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">12h00</span><span class="cat">Option A</span></div>
        <h4 class="i18n">National Gallery</h4>
        <p class="desc i18n">Trafalgar Square · entrée gratuite · plus de 2600 tableaux d'art occidental, de 1250 à 1900 · <b>enchaîné après le Hunterian Museum et Soane's Museum, sur le chemin naturel vers Covent Garden</b>. <b>🕒 Ouvert 10h-18h le jeudi</b> (jusqu'à 21h le vendredi uniquement). Visite resserrée à ~1h. <b>Histoire :</b> fondée en 1824, construite dès le départ comme collection publique plutôt qu'héritée d'une collection royale privée. <b>À ne pas rater :</b> les Tournesols de Van Gogh (salle 43, souvent moins fréquentée en fin de journée), le Bassin aux nymphéas de Monet, les Ambassadeurs de Holbein, le Portrait des Arnolfini de Van Eyck, et les salles impressionnistes/post-impressionnistes (Renoir, Cézanne, Seurat). Entrer par la Sainsbury Wing pour suivre l'ordre chronologique.</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">10h00</span><span class="cat">Option B</span></div>
        <h4 class="i18n">British Museum</h4>
        <p class="desc i18n">Collections mondiales · pierre de Rosette, frises du Parthénon · entrée gratuite. <b>🕒 Ouvert 10h-17h</b> (pas d'horaire prolongé le jeudi, contrairement au vendredi) — prévoir de sortir avant 17h. Visite resserrée à ~1h30. <b>Histoire :</b> fondé en 1753 à partir de la collection privée du médecin Hans Sloane, c'est le premier musée national public au monde, installé dans son bâtiment néoclassique actuel depuis 1852. <b>À ne pas rater :</b> la pierre de Rosette (salle 4, clé du déchiffrement des hiéroglyphes), les frises du Parthénon/marbres d'Elgin (salle 18), les momies égyptiennes et le sarcophage de Nesperennub (salles 62-63), le trésor de Sutton Hoo (salle 41, casque anglo-saxon), et la Grande Cour couverte de verre (Great Court), la plus grande place couverte d'Europe.</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">11h30</span><span class="cat">Option B</span></div>
        <h4 class="i18n">Hunterian Museum</h4>
        <p class="desc i18n">38-43 Lincoln's Inn Fields, Holborn · à 10 min à pied du British Museum · <b>si Option B choisie, à faire après</b> · collection médicale historique du chirurgien John Hunter (XVIIIe s.) : spécimens anatomiques, squelettes, instruments chirurgicaux d'époque · fascinant pour les curieux d'histoire de la médecine, mais clinique et parfois cru. <b>🕒 Ouvert mar-sam 10h-17h · Gratuit</b> (don de £3 suggéré) · billet horodaté gratuit recommandé en ligne. Visite resserrée à ~45 min. <b>Histoire :</b> John Hunter (1728-1793), pionnier de la chirurgie moderne et de l'anatomie comparée, a légué sa collection personnelle au Royal College of Surgeons ; le musée a rouvert en 2023 après 6 ans de rénovation. <b>À ne pas rater :</b> les instruments chirurgicaux de Joseph Lister (pionnier de l'antisepsie), les tables anatomiques du XVIIe siècle réalisées pour le diariste John Evelyn, et les spécimens pathologiques qui ont formé des générations de chirurgiens.</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">12h15</span><span class="cat">Option B</span></div>
        <h4 class="i18n">Sir John Soane's Museum</h4>
        <p class="desc i18n">13 Lincoln's Inn Fields · littéralement sur la même place que le Hunterian Museum, à traverser le square · maison de l'architecte néoclassique Sir John Soane, préservée telle qu'il l'a laissée à sa mort en 1837 · intérieur labyrinthique et spectaculaire : miroirs et perspectives truquées démultipliant l'espace, antiquités entassées du sol au plafond, un sarcophage égyptien en albâtre dans la cave. <b>🕒 Ouvert mer-dim 10h-17h (dernière entrée 16h30) · Gratuit</b> — pas de réservation nécessaire, mais file d'attente possible (capacité limitée). Visite resserrée à ~45 min. <b>Histoire :</b> Soane, architecte de la Banque d'Angleterre, a rassemblé ici 20 000 dessins d'architecture, des antiquités, et des œuvres de Turner, Canaletto et Piranèse ; si heureux de recevoir le sarcophage de Seti Ier qu'il organisa une fête de trois jours pour l'occasion. <b>À ne pas rater :</b> la série complète de "La Carrière d'un libertin" de Hogarth (derrière des panneaux à ouvrir soi-même), le sarcophage de Seti Ier, et la Breakfast Room, chef-d'œuvre de lumière et de miroirs.</p>
      </div>

      <div class="lodging" style="border-left:4px solid var(--red); flex-direction:column;">
        <div style="display:flex; gap:14px; align-items:center; margin-bottom:6px;">
          <div class="icon">🍽️</div>
          <h3 style="margin:0;">Déjeuner — autour de Covent Garden (13h00)</h3>
        </div>
        <div class="option-list" style="margin-top:4px;">
          <div><b>Flat Iron</b> — 17-18 Henrietta St · steak-frites généreux et pas cher · ~£15-20/pers · pas de réservation ✅</div>
          <div><b>Dishoom Covent Garden</b> — 12 Upper St Martin's Lane · brasserie irano-indienne, biryanis et black daal · ~£20-25/pers</div>
          <div><b>Barrafina Covent Garden</b> — 43 Drury Lane · tapas espagnoles au comptoir · ~£30-40/pers · pas de réservation, file rapide</div>
          <div><b>Henri</b> — bord de la Piazza · bistrot français, steak frites et moules marinière · ~£25-35/pers</div>
          <div><b>Wahaca</b> — mexicain coloré, tacos et burritos · ~£15-20/pers · rapide</div>
        </div>
        <span class="tag">📍 Tous à moins de 10 min à pied de Covent Garden</span>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">13h45</span><span class="cat">Balade</span></div>
        <h4 class="i18n">Covent Garden</h4>
        <p class="desc i18n">Halle marchande couverte, artistes de rue, boutiques et cafés. <b>Histoire :</b> ancien jardin des moines de Westminster Abbey ("Convent Garden"), transformé en marché de fruits et légumes dès 1654 puis en marché couvert victorien en 1830 ; les Beatles y ont donné un concert improvisé sur le balcon de l'Apple Corps en 1969, non loin. <b>Pourquoi y aller :</b> ambiance vivante et artistes de rue certifiés (audition officielle requise pour performer ici), architecture victorienne préservée, point de départ historique du West End théâtral juste à côté.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">15h15</span><span class="cat">Passage</span></div>
        <h4 class="i18n">Trafalgar Square</h4>
        <p class="desc i18n">Colonne de Nelson, fontaines · juste devant la National Gallery (déjà visitée le matin si Option A choisie). <b>Histoire :</b> aménagée en 1844 pour commémorer la victoire navale britannique à Trafalgar (1805) contre la flotte franco-espagnole ; la colonne (52m) est surmontée d'une statue de l'amiral Nelson, mort pendant la bataille. Les quatre lions de bronze à sa base ont été fondus à partir de canons français capturés. <b>Pourquoi y aller :</b> cœur symbolique de Londres, lieu de rassemblements historiques (manifestations, célébrations du Nouvel An), et point de vue idéal sur la National Gallery juste derrière.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">16h15</span><span class="cat">Passage</span></div>
        <h4 class="i18n">Fortnum & Mason</h4>
        <p class="desc i18n">Grand magasin emblématique de Piccadilly depuis 1707 · épicerie fine, thés, façade et vitrines élégantes · à 5 min à pied de Piccadilly Circus, où se trouve le West End. <b>🕒 Ouvert 10h-20h (jeudi inclus).</b> <b>Histoire :</b> fondé par William Fortnum (valet de chambre royal) et Hugh Mason en 1707 ; c'est Fortnum's qui aurait inventé le Scotch egg comme en-cas de voyage pour les diligences. Fournisseur officiel de la famille royale depuis des générations. <b>Pourquoi y aller :</b> l'horloge mécanique en façade s'anime chaque heure avec des automates de Fortnum et Mason, et le rayon épicerie/thé au rez-de-chaussée vaut le coup d'œil même sans acheter. <b>🛍️ À acheter :</b> thé au jasmin pour Chantal, au rayon thés du rez-de-chaussée.</p>
      </div>

      <div class="lodging" style="border-left:4px solid var(--red); flex-direction:column;">
        <div style="display:flex; gap:14px; align-items:center; margin-bottom:6px;">
          <div class="icon">🍽️</div>
          <h3 style="margin:0;">Dîner pré-spectacle — Soho / Piccadilly (17h30-18h30)</h3>
        </div>
        <div class="option-list" style="margin-top:4px;">
          <div><b>Barrafina</b> — Soho · tapas espagnoles au comptoir · ~£30-40/pers · pas de réservation, souvent la file mais ça tourne vite</div>
          <div><b>Bocca di Lupo</b> — Archer St · italien régional, partage · ~£35-45/pers</div>
          <div><b>Mildreds</b> — Soho · végétarien/végan généreux · ~£20-25/pers</div>
          <div><b>Bao</b> — Soho · bao taïwanais, rapide et convivial · ~£20-25/pers</div>
          <div><b>The Palomar</b> — Rupert St · cuisine levantine/israélienne · ~£35-45/pers · réservation conseillée</div>
        </div>
        <span class="tag">📍 Tous à 5-10 min à pied des théâtres — dîner avant le spectacle, cuisines sûres à cette heure</span>
      </div>

      <div class="stop">
        <div class="stop-top"><span class="time">19h30</span><span class="cat">Soirée</span></div>
        <h4 class="i18n">Soirée West End</h4>
        <p class="desc i18n">Comédie musicale ou spectacle dans le quartier des théâtres (Piccadilly / Leicester Square) — équivalent londonien de Broadway.</p>
      </div>
    </div>
  </div>

  <!-- JOUR 2 -->
  <div class="day-panel" id="day-2">
    <div class="day-head">
      <div class="d">Vendredi 11 Septembre</div>
      <h2 class="i18n">Les deux Tate — en bateau sur la Tamise</h2>
      <p class="i18n">Tate Modern, St Paul's, Tate Boat vers Tate Britain, puis Westminster à pied</p>
    </div>
    <div class="timeline">
      <div class="stop walk">
        <div class="stop-top"><span class="time">09h35</span><span class="cat">Trajet</span></div>
        <h4 class="i18n">Métro vers Tate Modern</h4>
        <p class="desc i18n">Depuis l'hôtel (Brick Lane) : marcher ~10 min jusqu'à <b>Liverpool Street</b>, puis <b>Central line</b> direction ouest jusqu'à <b>St Paul's</b> (4 arrêts : Bank, St Paul's) · ~8-10 min de trajet, sans changement · puis ~10-12 min à pied en traversant le Millennium Bridge jusqu'à Tate Modern (vue superbe sur la cathédrale en chemin).</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">10h00</span><span class="cat">Musée</span></div>
        <h4 class="i18n">Tate Modern</h4>
        <p class="desc i18n">Ancienne centrale électrique de Bankside · art moderne et contemporain · Turbine Hall spectaculaire · entrée gratuite pour la collection permanente. <b>🕒 Ouvert 10h-21h le vendredi</b> (horaires prolongés par rapport à Lun-Jeu, pas de contrainte horaire aujourd'hui). <b>Histoire :</b> ancienne centrale électrique désaffectée (Bankside Power Station, construite dans les années 1950-60 par Giles Gilbert Scott, aussi architecte des cabines téléphoniques rouges), reconvertie en musée en 2000 — l'un des projets de reconversion industrielle les plus réussis au monde. <b>À ne pas rater :</b> les œuvres de Rothko (salle dédiée), les Water Lilies de Monet, les installations souvent spectaculaires dans l'immense Turbine Hall (varie selon la période), et Picasso/Matisse dans les collections permanentes.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">11h45</span><span class="cat">Balade</span></div>
        <h4 class="i18n">Millennium Bridge</h4>
        <p class="desc i18n">Passerelle piétonne suspendue reliant la Tate Modern à St Paul's · vue emblématique sur la cathédrale · juste à côté de la Tate Modern. <b>Histoire :</b> inaugurée en 2000 pour le nouveau millénaire, elle a dû fermer 2 jours après son ouverture à cause d'un balancement latéral inattendu sous le pas des piétons ("Millennium Wobble") — rouverte seulement en 2002 après modifications. <b>Pourquoi y aller :</b> premier pont piéton sur la Tamise depuis plus d'un siècle, avec l'un des meilleurs axes de vue de Londres, cadrant St Paul's parfaitement dans son alignement.</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">12h15</span><span class="cat">Monument</span></div>
        <h4 class="i18n">St Paul's Cathedral</h4>
        <p class="desc i18n">Dôme baroque de Christopher Wren · vue extérieure ou montée jusqu'à la Whispering Gallery. <b>🕒 Ouvert lun-sam 8h30-16h30 (dernière entrée 16h00)</b> — visite touristique fermée le dimanche. <b>Histoire :</b> reconstruite par Christopher Wren après la destruction de l'édifice médiéval par le Grand Incendie de Londres (1666), achevée en 1710. A survécu miraculeusement au Blitz de 1940 — la photo du dôme intact au milieu des fumées de bombardement est devenue une icône de la résistance britannique. Lieu des funérailles de Churchill (1965) et du mariage de Charles et Diana (1981). <b>À ne pas rater :</b> la Whispering Gallery (murmurer contre le mur et être entendu à 30m de distance), la crypte (tombeaux de Nelson et Wellington), et la vue depuis la Golden Gallery tout en haut du dôme (528 marches).</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">13h00</span><span class="cat">Insolite</span></div>
        <h4 class="i18n">Postman's Park</h4>
        <p class="desc i18n">King Edward Street · à 5 min à pied de St Paul's · petit jardin victorien abritant le Mémorial aux actes d'héroïsme ordinaire : un mur de plaques en céramique racontant chacune l'histoire d'un Londonien anonyme mort en sauvant la vie d'un autre · émouvant et méconnu. <b>🕒 Accès libre, ouvert tous les jours (jardin public).</b> Gratuit.</p>
      </div>

      <div class="lodging" style="border-left:4px solid var(--red); flex-direction:column;">
        <div style="display:flex; gap:14px; align-items:center; margin-bottom:6px;">
          <div class="icon">🍽️</div>
          <h3 style="margin:0;">Restaurants proches de St Paul's / Borough (12h-13h)</h3>
        </div>
        <div class="option-list" style="margin-top:4px;">
          <div><b>Padella</b> — 6 Southwark St · Italien, pâtes fraîches · ~£15-20/pers · pas de réservation</div>
          <div><b>Arabica Bar and Kitchen</b> — Borough Market · levantin, mezze · ~£20-25/pers</div>
          <div><b>Watch House</b> — Bermondsey St · café/sandwichs rapides · ~£10-15/pers</div>
          <div><b>Casse-Croûte</b> — 109 Bermondsey St · bistrot français · ~£30-35/pers</div>
        </div>
        <span class="tag">📍 Tous à moins de 10 min de Postman's Park / Old Operating Theatre</span>
      </div>

      <div class="stop">
        <div class="stop-top"><span class="time">13h35</span><span class="cat">Insolite</span></div>
        <h4 class="i18n">Old Operating Theatre Museum</h4>
        <p class="desc i18n">9a St Thomas Street, juste à côté de Borough Market · ~15 min à pied depuis Postman's Park · plus ancien théâtre d'opération chirurgical d'Europe encore existant (1822), redécouvert par hasard en 1956 dans les combles d'une église · instruments chirurgicaux d'époque, avant l'anesthésie et les antiseptiques · accès par un escalier en colimaçon étroit. <b>🕒 Ouvert jeu-dim 10h30-17h00 (dernière entrée 16h15)</b> — ouvert le vendredi, jour de la visite. Payant (quelques livres), ~40 min.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">14h30</span><span class="cat">Bateau</span></div>
        <h4 class="i18n">Tate Boat — Bankside Pier → Millbank Pier</h4>
        <p class="desc i18n">Navette fluviale directe entre les deux Tate · ~18 min sur la Tamise · vue sur Big Ben, le London Eye et le Parlement · billet combiné possible avec l'entrée Tate Britain.</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">15h30</span><span class="cat">Musée</span></div>
        <h4 class="i18n">Tate Britain</h4>
        <p class="desc i18n">Art britannique du XVIe siècle à aujourd'hui · Turner, Hockney · bords de la Tamise à Millbank. <b>🕒 Ouvert 10h-18h (dernière entrée 17h30).</b> Visite resserrée à ~1h30. <b>Histoire :</b> ouverte en 1897 grâce au financement du magnat du sucre Henry Tate (qui a aussi donné son nom au sucre Tate & Lyle), sur le site d'une ancienne prison (Millbank Penitentiary). <b>À ne pas rater :</b> les salles Turner (la plus grande collection au monde de l'artiste, léguée par lui-même), les Pré-Raphaélites (Millais, Rossetti), Ophelia de Millais, et les œuvres de Francis Bacon et David Hockney dans les galeries d'art britannique moderne.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">17h00</span><span class="cat">Balade</span></div>
        <h4 class="i18n">Westminster & Big Ben</h4>
        <p class="desc i18n">15 min à pied depuis Tate Britain le long de la Tamise, via Victoria Tower Gardens · Houses of Parliament, Big Ben, Westminster Abbey. <b>Histoire :</b> le Palais de Westminster actuel date de 1840-1870 (reconstruit après un incendie), sur un site utilisé comme résidence royale et siège du pouvoir depuis le XIe siècle. "Big Ben" est en réalité le nom de la cloche (13,7 tonnes), pas de la tour elle-même (officiellement Elizabeth Tower depuis 2012). Westminster Abbey a accueilli tous les couronnements royaux depuis 1066. <b>Pourquoi y aller :</b> c'est le cœur institutionnel du Royaume-Uni, gothique revival spectaculaire, encore plus impressionnant à la tombée du jour quand les tours s'illuminent.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">17h45</span><span class="cat">Trajet</span></div>
        <h4 class="i18n">Métro vers Tower Hill</h4>
        <p class="desc i18n">District/Circle line, direct depuis Westminster · ~20-25 min · sur le chemin du retour vers l'hôtel.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">18h15</span><span class="cat">Passage</span></div>
        <h4 class="i18n">Tower of London (extérieur)</h4>
        <p class="desc i18n">Simple passage devant la forteresse, sans visite payante · vue sur les douves et les tours depuis l'extérieur · à combiner avec Tower Bridge juste à côté. <b>Histoire :</b> fondée par Guillaume le Conquérant en 1078 (la Tour Blanche centrale), elle a servi tour à tour de palais royal, de prison (Anne Boleyn y a été exécutée en 1536), d'arsenal, et abrite aujourd'hui les joyaux de la Couronne. Les corbeaux qui y vivent sont protégés par la légende : si les corbeaux quittent la Tour, la Couronne tombera. <b>Pourquoi la voir même de l'extérieur :</b> presque 1000 ans d'histoire concentrés sur un site, silhouette immédiatement reconnaissable au bord de la Tamise.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">18h30</span><span class="cat">Passage</span></div>
        <h4 class="i18n">Tower Bridge</h4>
        <p class="desc i18n">Passage à pied sur le pont-levis le plus photographié de Londres · lumière du soir agréable. <b>Histoire :</b> construit entre 1886 et 1894 pour désengorger le trafic tout en préservant l'accès des grands navires au port de Londres — d'où son mécanisme de bascule (bascule bridge), toujours fonctionnel aujourd'hui (les deux tablettes se soulèvent encore pour laisser passer de grands bateaux, plusieurs fois par semaine). Souvent confondu à tort avec "London Bridge" par les touristes. <b>Pourquoi y aller :</b> l'un des ponts les plus reconnaissables au monde, architecture gothique victorienne, passerelle vitrée en hauteur (payante) offrant une vue plongeante sur la Tamise.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">18h50</span><span class="cat">Passage</span></div>
        <h4 class="i18n">London Bridge</h4>
        <p class="desc i18n">15 min à pied depuis Tower Bridge · vue sur The Shard · puis retour à pied ou en métro vers Brick Lane (~15-20 min). <b>Histoire :</b> le pont actuel date de 1973 (le précédent, du XIXe siècle, a été vendu et reconstruit pierre par pierre en Arizona, aux États-Unis, en 1968 — une légende urbaine tenace veut que l'acheteur américain ait cru acheter Tower Bridge par erreur). Un pont existe à cet emplacement depuis l'époque romaine. <b>Pourquoi y aller :</b> moins spectaculaire que Tower Bridge mais stratégique pour la vue sur The Shard et le quartier de la City qui s'illumine en soirée.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">19h05</span><span class="cat">Option</span></div>
        <h4 class="i18n">Leadenhall Market</h4>
        <p class="desc i18n">~10-12 min à pied depuis London Bridge, dans la City · halle marchande victorienne couverte, verrière en fer et verre peinte de vert et bordeaux, pavage d'origine. <b>Pourquoi y aller :</b> c'est ici qu'a été tourné le passage vers le Chemin de Traverse dans les films Harry Potter (l'entrée du Leaky Cauldron était filmée à l'entrée de Bull's Head Passage) · l'un des plus beaux exemples d'architecture marchande victorienne encore en activité à Londres, avec des bâtiments romains sous les fondations (ancien forum de Londinium). <b>⚠️ Impact horaire :</b> détour optionnel de ~20-25 min avant de rejoindre le Viktor Wynd Museum (rallonge le trajet vers Hackney) · à faire seulement si l'envie est là, sinon foncer directement vers Hackney. <b>🕒 Accès libre, ambiance surtout animée en semaine aux heures de bureau</b> (plus calme le soir, mais l'architecture reste visible).</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">19h43</span><span class="cat">Insolite</span></div>
        <h4 class="i18n">Viktor Wynd Museum of Curiosities</h4>
        <p class="desc i18n">11 Mare Street, Hackney · ~30-35 min de trajet depuis London Bridge (bus ou métro avec correspondance) · cabinet de curiosités excentrique : taxidermie, têtes réduites, art surréaliste et occulte, également bar à cocktails à l'étage · ambiance décalée façon Wunderkammer victorien, pour les simplement curieux. <b>🕒 Ouvert mar-ven 15h-23h · sam 12h-23h · dim 12h-22h · Entrée £12</b> (billet horodaté requis) · possibilité de finir la soirée au bar sur place. <b>🎟️ Créneaux de réservation vendredi :</b> 18h00, 18h45, 19h30 ou 20h15.</p>
      </div>
      <div class="stop restaurant">
        <div class="stop-top"><span class="time">21h00</span><span class="cat">Dîner</span></div>
        <h4 class="i18n">Dîner près de l'hôtel</h4>
        <p class="desc i18n">De retour à Shoreditch après la visite du musée · Smokestak, Dishoom ou Poppies Fish & Chips.</p>
      </div>
    </div>
  </div>

  <!-- JOUR 3 -->
  <div class="day-panel" id="day-3">
    <div class="day-head">
      <div class="d">Samedi 12 Septembre</div>
      <h2 class="i18n">Notting Hill, Freud Museum & Camden</h2>
      <p class="i18n">Portobello Road, la maison de Sigmund Freud, marché alternatif et pub légendaire</p>
    </div>
    <div class="timeline">
      <div class="stop walk">
        <div class="stop-top"><span class="time">09h30</span><span class="cat">Trajet</span></div>
        <h4 class="i18n">Métro vers Notting Hill</h4>
        <p class="desc i18n">Depuis l'hôtel (Brick Lane) : marcher ~10 min jusqu'à <b>Liverpool Street</b>, puis <b>Central line</b> direction ouest jusqu'à <b>Notting Hill Gate</b> (10 arrêts : Bank, St Paul's, Chancery Lane, Holborn, Tottenham Court Road, Oxford Circus, Bond Street, Marble Arch, Lancaster Gate, Queensway, Notting Hill Gate) · ~25-30 min de trajet, sans changement.</p>
      </div>
      <div class="stop restaurant">
        <div class="stop-top"><span class="time">10h00</span><span class="cat">Petit-déj</span></div>
        <h4 class="i18n">Cheeky Scone</h4>
        <p class="desc i18n">43 Pembridge Road, W11 3HG · à 2-3 min à pied de Notting Hill Gate · boutique entièrement dédiée au scone, dans toutes ses déclinaisons (nature, citron-myrtille, chocolat, fromage...) avec confiture et crème caillée. <b>🕒 Ouvert samedi 10h-17h30.</b> File d'attente fréquente le samedi matin, mieux vaut y être tôt.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">10h45</span><span class="cat">Passage</span></div>
        <h4 class="i18n">Portobello Road Market</h4>
        <p class="desc i18n">Le marché aux puces/antiquités le plus connu de Londres, complet et animé le samedi (jour idéal) · maisons pastel typiques du quartier, rendu célèbre par le film éponyme.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">11h45</span><span class="cat">Trajet</span></div>
        <h4 class="i18n">Métro vers Hampstead</h4>
        <p class="desc i18n">Central line puis changement (Jubilee ou bus) vers Finchley Road/Swiss Cottage · ~30-35 min.</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">12h20</span><span class="cat">Musée</span></div>
        <h4 class="i18n">Freud Museum</h4>
        <p class="desc i18n">20 Maresfield Gardens, Hampstead · ancienne maison de Sigmund Freud, son cabinet et son célèbre divan préservés · petit musée intimiste. <b>🕒 Ouvert 10h30-17h00 le samedi.</b></p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">13h35</span><span class="cat">Trajet</span></div>
        <h4 class="i18n">Métro vers Camden</h4>
        <p class="desc i18n">Pas de ligne directe en métro depuis le Freud Museum · le plus simple : <b>bus 268</b> depuis l'arrêt Fitzjohn's Avenue (2 min à pied du musée) jusqu'à <b>Camden Town</b>, ~15-20 min · alternative en métro : marcher ~10 min jusqu'à <b>Finchley Road</b> (Jubilee/Metropolitan line), puis Jubilee line jusqu'à Baker Street, puis Northern line jusqu'à <b>Camden Town</b> (1 changement) · ~25 min au total.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">13h50</span><span class="cat">Passage</span></div>
        <h4 class="i18n">Camden Market</h4>
        <p class="desc i18n">Étals, mode alternative, ambiance unique · à parcourir sans se presser. <b>🕒 Ouvert 7j/7, 10h-18h.</b></p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">14h30</span><span class="cat">Insolite</span></div>
        <h4 class="i18n">The Hawley Arms</h4>
        <p class="desc i18n">2 Castlehaven Road · pub légendaire fréquenté par Amy Winehouse dans les années 2000 · un passage rapide ou un verre pour les passionnés de musique.</p>
      </div>
      <div class="stop restaurant">
        <div class="stop-top"><span class="time">15h00</span><span class="cat">Déjeuner</span></div>
        <h4 class="i18n">Camden Lock</h4>
        <p class="desc i18n">Bords du Regent's Canal · street food internationale · déjeuner tardif/encas pour finir la journée.</p>
      </div>
    </div>

    <div class="lodging" style="border-left:4px solid var(--red);">
      <div class="icon">🍽️</div>
      <div>
        <h3 style="margin:0 0 4px;">Dîner samedi soir — proche de l'hôtel</h3>
        <p style="margin:0;">Soirée libre après le déjeuner tardif à Camden · retour à Shoreditch pour dîner, voir la liste "Restaurants proches de l'hôtel" en haut du programme.</p>
      </div>
    </div>
  </div>

  <!-- JOUR 4 -->
  <div class="day-panel" id="day-4">
    <div class="day-head">
      <div class="d">Dimanche 13 Septembre</div>
      <h2 class="i18n">V&amp;A & départ vol 17h40</h2>
      <p class="i18n">Design & arts décoratifs, passage au Natural History Museum, option Science Museum · Tower Bridge, Tower of London et London Bridge déjà vus le jeudi</p>
    </div>
    <div class="lodging" style="border-left:4px solid var(--navy); margin-bottom:16px;">
      <div class="icon">✈️</div>
      <div>
        <h3 class="i18n">Vol retour — Ricardo, Alexia & Chantal</h3>
        <p>Gatwick → BCN · départ 17h40, arrivée 20h50 · <b>pas de bagage en soute, enregistrement en ligne fait</b></p>
        <p>Depuis South Kensington : métro vers Victoria (~15 min) puis Gatwick Express (~30 min, un train toutes les 15 min) · départ vers 14h30, arrivée aéroport ~15h30, soit ~2h10 de marge — suffisant sans bagage/enregistrement à faire sur place.</p>
      </div>
    </div>
    <div class="timeline">
      <div class="stop walk">
        <div class="stop-top"><span class="time">09h20</span><span class="cat">Trajet</span></div>
        <h4 class="i18n">Métro vers South Kensington</h4>
        <p class="desc i18n">Depuis l'hôtel (Brick Lane) : marcher ~10 min jusqu'à <b>Liverpool Street</b>, puis <b>Circle line</b> jusqu'à <b>South Kensington</b> · ~30-35 min de trajet, sans changement (ligne directe, fait le tour par Westminster et Victoria) · le V&A est juste à la sortie du métro (accès direct par le tunnel piéton souterrain depuis la station).</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">10h00</span><span class="cat">Musée</span></div>
        <h4 class="i18n">Victoria and Albert Museum</h4>
        <p class="desc i18n">Design, mode et arts décoratifs · quartier South Kensington · l'un des plus grands musées d'art décoratif au monde · entrée gratuite pour la collection permanente. <b>🕒 Ouvert 10h-17h45.</b> Visite d'environ 2h, sans se presser. <b>Histoire :</b> fondé en 1852 sous le nom de South Kensington Museum, financé par les bénéfices de la Grande Exposition de 1851 ; renommé en 1899 en l'honneur de la reine Victoria et du prince Albert, qui ont posé la première pierre du bâtiment actuel. <b>À ne pas rater :</b> la Great Bed of Ware (lit Renaissance monumental mentionné par Shakespeare), les Cast Courts (moulages grandeur nature de la colonne Trajane et du David de Michel-Ange), la collection de mode et costumes, et les bijoux de la galerie Jewellery.</p>
      </div>
      <div class="stop restaurant">
        <div class="stop-top"><span class="time">12h00</span><span class="cat">Déjeuner</span></div>
        <h4 class="i18n">V&A Café</h4>
        <p class="desc i18n">Au V&A · Britannique (self-service, plats chauds, salades, pâtisseries) · ~£15-20/pers · premier café de musée au monde (1868).</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">12h30</span><span class="cat">Option</span></div>
        <h4 class="i18n">Natural History Museum — juste pour le bâtiment</h4>
        <p class="desc i18n">À 2 min à pied du V&A · pas la peine de faire toute la visite (dinosaures/baleine bleue déjà vus en profondeur à l'AMNH de New York, en plus petit et redondant ici) · en revanche le <b>Hintze Hall</b> vaut le détour à lui seul : architecture néo-romane spectaculaire, presque une cathédrale · 10-15 min suffisent pour l'admirer et repartir, en passage rapide. <b>🕒 Ouvert tous les jours 10h-17h50 (dernière entrée 17h30).</b> Gratuit. <b>Histoire :</b> issu des collections d'histoire naturelle du British Museum, séparé en musée indépendant en 1881 dans ce bâtiment signé Alfred Waterhouse, financé grâce aux collections léguées par le naturaliste Hans Sloane. <b>À ne pas manquer même en passant vite :</b> "Hope", le squelette de baleine bleue suspendu au plafond du Hintze Hall (a remplacé le célèbre "Dippy" le diplodocus en 2017), et les détails sculptés d'animaux et plantes sur chaque colonne et arche du hall, typiques du style architectural romane victorien.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">12h45</span><span class="cat">Option</span></div>
        <h4 class="i18n">Science Museum (en option)</h4>
        <p class="desc i18n">Juste en face du Natural History Museum · gratuit · pour un aperçu très rapide (~15 min) : Flight (histoire de l'aviation), Espace (module Apollo 10), ou Mathematics: The Winton Gallery. <b>🕒 Ouvert tous les jours 10h-18h (dernière entrée 17h15).</b> <b>⚠️ Impact horaire :</b> décale tout le reste de ~15 min et réduit légèrement la marge avant le vol — à faire seulement si l'envie est forte, ou en sautant Leighton House pour compenser. <b>Histoire :</b> né en 1857 des collections scientifiques et industrielles de la Grande Exposition de 1851 (comme le V&A et le Natural History Museum, tous trois issus du même héritage), séparé du V&A en 1909. <b>À ne pas rater si vous passez :</b> le vrai module de commande Apollo 10 (seul objet ayant réellement volé vers la Lune et en revenant, exposé tel quel avec ses traces de rentrée atmosphérique), et la machine à vapeur de Newcomen (1712), l'une des premières machines à vapeur industrielles au monde.</p>
      </div>
      <div class="stop walk">
        <div class="stop-top"><span class="time">13h00</span><span class="cat">Trajet</span></div>
        <h4 class="i18n">Métro vers Holland Park</h4>
        <p class="desc i18n">South Kensington → Holland Park ou High Street Kensington · ~15-20 min (bus ou métro avec correspondance).</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">13h20</span><span class="cat">Musée</span></div>
        <h4 class="i18n">Leighton House</h4>
        <p class="desc i18n">12 Holland Park Road · ancienne maison-atelier du peintre victorien Frederic, Lord Leighton (1830-1896), la seule maison-atelier d'artiste construite à cet effet encore ouverte au public au Royaume-Uni · <b>l'Arab Hall</b> est le clou de la visite : dôme doré, mosaïques et carreaux de céramique islamique des XVIe-XVIIe siècles, fontaine intérieure. <b>🕒 Ouvert mer-lun 10h-17h30 (dernière entrée 16h30) · Entrée ~£14</b>. <b>Histoire :</b> Leighton a fait construire l'Arab Hall entre 1877 et 1881 pour abriter sa collection de céramiques islamiques rapportées de ses voyages au Moyen-Orient ; sa maison a donné naissance au "Holland Park Circle", une colonie d'artistes qui s'est installée dans le quartier à sa suite. <b>À ne pas rater :</b> l'Arab Hall bien sûr, mais aussi l'atelier de peinture de Leighton à l'étage, éclairé par une grande verrière nord, et les œuvres de Burne-Jones, Millais et Alma-Tadema dans la collection permanente.</p>
      </div>
      <div class="stop">
        <div class="stop-top"><span class="time">14h10</span><span class="cat">Départ</span></div>
        <h4 class="i18n">Métro vers Victoria puis Gatwick Express</h4>
        <p class="desc i18n">Holland Park/Kensington → Victoria (~20-25 min, District line) → Gatwick Express (~30 min) · arrivée à l'aéroport vers 15h05-15h20, soit ~2h20-2h35 de marge avant l'embarquement du vol de 17h40 (ou ~2h40-2h55 si le Science Museum optionnel est sauté) · confortable sans bagage en soute et avec l'enregistrement déjà fait en ligne.</p>
      </div>
    </div>
  </div>

  <section class="map-section">
    <h2>🗺️ Carte interactive</h2>
      <p class="i18n">Logement, restaurant et étapes des 4 jours</p>
    <div id="map"></div>
    <div class="legend">
      <span>🏠 Logement Airbnb</span>
      <span>🏨 Hôtel (sœur de Ricardo)</span>
      <span><i class="dot" style="background:#c1272d"></i> Restaurant</span>
      <span><i class="dot" style="background:#6d6875"></i> Arrivées</span>
      <span><i class="dot" style="background:#457b9d"></i> 10 Sept</span>
      <span><i class="dot" style="background:#8e44ad"></i> 11 Sept</span>
      <span><i class="dot" style="background:#2a9d8f"></i> 12 Sept</span>
      <span><i class="dot" style="background:#e76f51"></i> 13 Sept</span>
    </div>
  </section>

</main>

<footer class="i18n">4 jours à Londres · Tate Modern · Tate Britain · V&amp;A · British Museum · Camden · West End · les ponts</footer>

<script>
  const buttons = document.querySelectorAll('nav.days button');
  const panels = document.querySelectorAll('.day-panel');
  buttons.forEach(btn=>{
    btn.addEventListener('click', ()=>{
      buttons.forEach(b=>b.classList.remove('active'));
      panels.forEach(p=>p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('day-'+btn.dataset.day).classList.add('active');
    });
  });

  const map = L.map('map').setView([51.5145, -0.1050], 12);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors'
  }).addTo(map);

  function icon(color){
    return L.divIcon({
      className:'',
      html:`<div style="background:${color};width:14px;height:14px;border-radius:50%;border:2px solid white;box-shadow:0 0 3px rgba(0,0,0,0.4);"></div>`,
      iconSize:[14,14],
      iconAnchor:[7,7]
    });
  }

  function houseIcon(){
    return L.divIcon({
      className:'',
      html:`<div style="background:#b8860b;width:30px;height:30px;border-radius:50% 50% 50% 0;border:2px solid white;box-shadow:0 0 4px rgba(0,0,0,0.5);transform:rotate(45deg);display:flex;align-items:center;justify-content:center;">
              <span style="transform:rotate(-45deg);font-size:14px;">🏠</span>
            </div>`,
      iconSize:[30,30],
      iconAnchor:[15,30],
      popupAnchor:[0,-28]
    });
  }

  function hotelIcon(){
    return L.divIcon({
      className:'',
      html:`<div style="background:#722f37;width:30px;height:30px;border-radius:50% 50% 50% 0;border:2px solid white;box-shadow:0 0 4px rgba(0,0,0,0.5);transform:rotate(45deg);display:flex;align-items:center;justify-content:center;">
              <span style="transform:rotate(-45deg);font-size:14px;">🏨</span>
            </div>`,
      iconSize:[30,30],
      iconAnchor:[15,30],
      popupAnchor:[0,-28]
    });
  }

  const NAVY = '#1d3557', RED = '#c1272d', GOLD = '#b8860b';
  const DAY_COLORS = { 0:'#6d6875', 1:'#457b9d', 2:'#8e44ad', 3:'#2a9d8f', 4:'#e76f51' };

  // Logement — marqueur maison, non relié aux jours
  const lodging = {lat:51.5203, lng:-0.0716, name:"🏠 Logement Airbnb — Flat 8, 202-204 Brick Lane, E1 6SA"};
  L.marker([lodging.lat, lodging.lng], {icon: houseIcon()}).addTo(map).bindPopup(lodging.name);

  // Hôtel de la sœur de Ricardo — marqueur hôtel dédié, non relié aux jours
  const sisterHotel = {lat:51.5090, lng:-0.1968, name:"🏨 Hotel Ruby Zoe d'Annamaria — hôtel de la sœur de Ricardo · Notting Hill Gate"};
  L.marker([sisterHotel.lat, sisterHotel.lng], {icon: hotelIcon()}).addTo(map).bindPopup(sisterHotel.name);

  // Restaurants — marqueurs indépendants, non reliés au parcours officiel
  const restaurants = [
    // Shoreditch / près de l'hôtel
    {lat:51.5236, lng:-0.0748, name:"🍽️ SMOKESTAK — BBQ au feu de bois · ~£30-40/pers"},
    {lat:51.5229, lng:-0.0724, name:"🍟 Poppies Fish & Chips — l'incontournable du quartier · ~£15-20/pers"},
    {lat:51.5265, lng:-0.0817, name:"🍽️ Smoking Goat Shoreditch — thaï grillé · ~£25-30/pers"},
    {lat:51.5259, lng:-0.0782, name:"🍽️ Dishoom Shoreditch — irano-indien · ~£20-25/pers"},
    {lat:51.5236, lng:-0.0779, name:"🍽️ Cecconi's Shoreditch — italien chic · ~£45-60/pers"},
