    {lat:51.5010, lng:-0.0800, name:"🍽️ Casse-Croûte — bistrot français · ~£30-35/pers"},

    // Vendredi — autour de Covent Garden / Bloomsbury
    {lat:51.5117, lng:-0.1258, name:"🍽️ Flat Iron Covent Garden — britannique, steak-frites · ~£15-20/pers ✅ (au programme)"},
